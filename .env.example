EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-potente-aqui-caro-padawan
EVOLUTION_INSTANCE=instance name

# Server
AUTHENTICATION_API_KEY=${EVOLUTION_API_KEY}
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
PORT=5000

# Cache (Redis)
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false

# Logs
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=true
LOG_BAILEYS=error

# Dipositivos
WIN_MNZ_IP=192.168.0.1
WIN_MNZ_USER=user
WIN_MNZ_PASSWORD=senha
WIN_MNZ_PORT=22
WIN_MNZ_TIMEOUT=5
WIN_MNZ_MAC=00-11-22-33-44-55
WIN_MNZ_BROADCAST=255.255.255.255
WIN_MNZ_WOL_PORT=9

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/whatsapp_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whatsapp_bot

# Security, Encryption & RBAC Registration
# Gere uma chave Fernet base64 de 32 bytes com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
HMAC_SECRET=
SYSTEM_REGISTRATION_PASSWORD=TroqueEstaSenhaUnica123
ADMIN_REMOTE_JIDS=5511999999999@s.whatsapp.net:Arthur Muniz,5511888888888@s.whatsapp.net:Admin Secundario

# LLM Provider & Models (OpenRouter, OpenAI, Ollama, LM Studio, vLLM)
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_CHAT_MODEL=google/gemini-2.5-flash
LLM_CV_MODEL=google/gemini-2.5-flash
LLM_TEMPERATURE=0.3

# Web UI Authentication (JWT) & CORS
JWT_SECRET=
JWT_EXPIRES_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000

# Storage for Resumes & Generated PDFs/DOCX
GENERATED_CVS_DIR=data/generated_cvs
UPLOADED_CVS_DIR=data/uploaded_cvs
