       def _parse_flags(source, state, char):
   15:     sourceget = source.get
   15:     add_flags = 0
   15:     del_flags = 0
   15:     if char != "-":
   15:         while True:
   15:             flag = FLAGS[char]
   15:             if source.istext:
   15:                 if char == 'L':
