  185:         if not flags & SRE_FLAG_ASCII:
  173:             flags |= SRE_FLAG_UNICODE
   12:         elif flags & SRE_FLAG_UNICODE:
                   raise ValueError("ASCII and UNICODE flags are incompatible")
