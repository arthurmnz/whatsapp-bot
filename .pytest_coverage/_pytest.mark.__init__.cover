    1:     MARK_GEN._config = config
       
           # Eagerly validate the value; it is only read lazily during collection.
    1:     config.getini(EMPTY_PARAMETERSET_OPTION)
       
       
    1: def pytest_unconfigure(config: Config) -> None:
    1:     MARK_GEN._config = config.stash.get(old_mark_config_key, None)
