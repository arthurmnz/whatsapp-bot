  116:         self.position.advance(self.string[match.start() : match.end()])
  116:         return match.groups()
       
       
    1: def decode_escapes(regex: Pattern[str], string: str) -> str:
           def decode_match(match: Match[str]) -> str:
               return codecs.decode(match.group(0), "unicode-escape")  # type: ignore
       
           return regex.sub(decode_match, string)
       
       
    1: def parse_key(reader: Reader) -> Optional[str]:
   16:     char = reader.peek(1)
   16:     if char == "#":
    4:         return None
   12:     elif char == "'":
               (key,) = reader.read_regex(_single_quoted_key)
           else:
   12:         (key,) = reader.read_regex(_unquoted_key)
   12:     return key
       
       
    1: def parse_unquoted_value(reader: Reader) -> str:
