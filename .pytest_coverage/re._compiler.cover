       def _compile_charset(charset, flags, code):
           # compile charset subprogram
  720:     emit = code.append
 1671:     for op, av in charset:
  951:         emit(op)
  951:         if op is NEGATE:
   59:             pass
  892:         elif op is LITERAL:
  217:             emit(av)
  675:         elif op is RANGE or op is RANGE_UNI_IGNORE:
  180:             emit(av[0])
  180:             emit(av[1])
  495:         elif op is CHARSET:
  224:             code.extend(av)
  271:         elif op is BIGCHARSET:
   10:             code.extend(av)
  261:         elif op is CATEGORY:
  261:             if flags & SRE_FLAG_LOCALE:
                       emit(CH_LOCALE[av])
  261:             elif flags & SRE_FLAG_UNICODE:
  167:                 emit(CH_UNICODE[av])
                   else:
   94:                 emit(av)
               else:
                   raise PatternError(f"internal: unsupported set operator {op!r}")
  720:     emit(FAILURE)
       
