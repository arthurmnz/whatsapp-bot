       _CODEBITS = _sre.CODESIZE * 8
       MAXCODE = (1 << _CODEBITS) - 1
       _BITS_TRANS = b'0' + b'1' * 255
       def _mk_bitmap(bits, _CODEBITS=_CODEBITS, _int=int):
  234:     s = bits.translate(_BITS_TRANS)[::-1]
 2282:     return [_int(s[i - _CODEBITS: i], 2)
 2516:             for i in range(len(s), 0, -_CODEBITS)]
       
       def _bytes_to_codes(b):
           # Convert block indices to word array
   10:     a = memoryview(b).cast('I')
   10:     assert a.itemsize == _sre.CODESIZE
   10:     assert len(a) * a.itemsize == len(b)
   10:     return a.tolist()
       
       def _simple(p):
           # check if this subpattern is a "simple" operator
  852:     if len(p) != 1:
  159:         return False
  693:     op, av = p[0]
  693:     if op is SUBPATTERN:
   64:         return av[0] is None and _simple(av[-1])
  629:     return op in _UNIT_CODES
       
       def _generate_overlap_table(prefix):
           """
           Generate an overlap table for the following prefix.
           An overlap table is a table of the same size as the prefix which
           informs about the potential self-overlap for each index in the prefix:
           - if overlap[i] == 0, prefix[i:] can't overlap prefix[0:...]
           - if overlap[i] == k with 0 < k <= i, prefix[i-k+1:i+1] overlaps with
             prefix[0:k]
           """
   49:     table = [0] * len(prefix)
  125:     for i in range(1, len(prefix)):
   76:         idx = table[i - 1]
   78:         while prefix[i] != prefix[idx]:
   74:             if idx == 0:
   72:                 table[i] = 0
   72:                 break
    2:             idx = table[idx - 1]
               else:
    4:             table[i] = idx + 1
   49:     return table
       
