  179:     if TYPE_CHECKING:
               teardown = cast(Teardown, res)
           else:
  179:         teardown = res
  179:     try:
  179:         next(teardown)
           except StopIteration:
               _raise_wrapfail(teardown, "did not yield")
  179:     try:
  179:         res = yield
  179:         result = Result(res, None)
           except BaseException as exc:
               result = Result(None, exc)
  179:     try:
  179:         teardown.send(result)
  179:     except StopIteration:
  179:         pass
           except BaseException as e:
