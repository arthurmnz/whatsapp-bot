    1: from __future__ import annotations
       
    1: from dataclasses import dataclass
    1: from typing import ClassVar
    1: from typing import Literal
    1: from typing import Protocol
       
       
    1: _AssertionTextDiffStyle = Literal["ndiff", "block"]
       
       
    3: @dataclass(frozen=True, kw_only=True, slots=True)
    2: class TruncationBudget:
    1:     """Per-explanation budget for truncating assertion output.
       
           ``max_lines`` / ``max_chars`` mirror the ``truncation_limit_lines`` /
           ``truncation_limit_chars`` ini values: a positive limit bounds that
           dimension; ``0`` leaves it unbounded (the limit is disabled).
           """
       
           #: Default limits applied when the corresponding ini option is left unset.
    1:     DEFAULT_MAX_LINES: ClassVar[int] = 8
    1:     DEFAULT_MAX_CHARS: ClassVar[int] = DEFAULT_MAX_LINES * 80
       
    1:     max_lines: int = DEFAULT_MAX_LINES
    1:     max_chars: int = DEFAULT_MAX_CHARS
       
       
       # Reusable "no cap" budget, used as a default argument (B008).
    1: NO_TRUNCATION_BUDGET = TruncationBudget(max_lines=0, max_chars=0)
       
       
    2: class _HighlightFunc(Protocol):  # noqa: PYI046
    1:     def __call__(self, source: str, lexer: Literal["diff", "python"] = "python") -> str:
               """Apply highlighting to the given source."""
