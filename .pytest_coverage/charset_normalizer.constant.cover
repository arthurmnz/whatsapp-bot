    1: LANGUAGE_SUPPORTED_COUNT: int = len(FREQUENCIES)
       
       # Bit flags for unified character classification.
       # A single unicodedata.name() call sets all relevant flags at once.
    1: _LATIN: int = 1
    1: _ACCENTUATED: int = 1 << 1
    1: _CJK: int = 1 << 2
    1: _HANGUL: int = 1 << 3
    1: _KATAKANA: int = 1 << 4
    1: _HIRAGANA: int = 1 << 5
    1: _THAI: int = 1 << 6
    1: _ARABIC: int = 1 << 7
    1: _ARABIC_ISOLATED_FORM: int = 1 << 8
    1: _HALFWIDTH_KATAKANA: int = 1 << 9
    1: _LIGATURE: int = 1 << 10
    1: _SUPERSCRIPT: int = 1 << 11
    1: _SENTENCE_OPEN_PUNCTUATION: int = 1 << 12
       
    1: _ACCENT_KEYWORDS: tuple[str, ...] = (
           "WITH GRAVE",
           "WITH ACUTE",
           "WITH CEDILLA",
           "WITH DIAERESIS",
           "WITH CIRCUMFLEX",
           "WITH TILDE",
           "WITH MACRON",
           "WITH RING ABOVE",
       )
       
       # Pre-built lookup structures for FREQUENCIES (computed once at import time).
       # character -> rank mapping per language (replaces list .index() calls).
    2: _FREQUENCIES_RANK: dict[str, dict[str, int]] = {
 1368:     lang: {char: rank for rank, char in enumerate(chars)}
   43:     for lang, chars in FREQUENCIES.items()
       }
       
       # frozenset per language (avoids rebuilding set() per call).
    2: _FREQUENCIES_SET: dict[str, frozenset[str]] = {
   43:     lang: frozenset(chars) for lang, chars in FREQUENCIES.items()
       }
       
       # prebuilt list of secondary range names.
    3: _SECONDARY_RANGE_NAMES: frozenset[str] = frozenset(
  347:     range_name
  349:     for range_name in UNICODE_RANGES_COMBINED
 8212:     if any(keyword in range_name for keyword in UNICODE_SECONDARY_RANGE_KEYWORD)
       )
       
    2: _KNOWN_MB_DECODERS: frozenset[str] = frozenset(
    1:     {
               "utf_8",
               "utf_8_sig",
               "utf_16",
               "utf_16_be",
               "utf_16_le",
               "utf_32",
               "utf_32_le",
               "utf_32_be",
               "utf_7",
           }
       )
       
    2: _KNOWN_MB_CLASSES: frozenset[str] = frozenset(
    1:     {
               "_codecs_cn",
               "_codecs_hk",
               "_codecs_iso2022",
               "_codecs_jp",
               "_codecs_kr",
               "_codecs_tw",
           }
       )
       
    3: _IANA_NAMES: dict[str, str] = {
    1:     **aliases,
  342:     **{iana_name: iana_name for iana_name in aliases.values()},
       }
    1: _MULTIBYTE_SEARCH_RADIUS: int = 32768
