    2: class CompatibleFamillyRange:
    1:     __slots__ = ("_families",)
       
    1:     def __init__(self, familly_a: str, familly_b: str) -> None:
   24:         self._families: frozenset[str] = frozenset((familly_a, familly_b))
       
    1:     def __eq__(self, other: object) -> bool:
               if not isinstance(other, CompatibleFamillyRange):
                   return NotImplemented
       
               return self._families == other._families
       
    1:     def __hash__(self) -> int:
   24:         return hash(self._families)
       
       
