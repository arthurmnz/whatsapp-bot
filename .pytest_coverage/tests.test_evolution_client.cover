       # ─── 1. Testes de _convert_gif_to_mp4 ─────────────────────────────────────────
       
    3: def test_convert_gif_to_mp4_no_ffmpeg(tmp_path: Path):
    1:     fake_gif = tmp_path / "animation.gif"
    1:     fake_gif.write_bytes(b"GIF89a...")
       
    2:     with patch("shutil.which", return_value=None):
    1:         result = _convert_gif_to_mp4(fake_gif)
    1:         assert result is None
       
       
    3: def test_convert_gif_to_mp4_success(tmp_path: Path):
    1:     fake_gif = tmp_path / "test.gif"
    1:     fake_gif.write_bytes(b"GIF89a_fake_data")
    1:     mock_mp4_content = b"\x00\x00\x00\x18ftypmp42"
       
    1:     recorded_cmd = []
       
    1:     def mock_run(cmd, *args, **kwargs):
    1:         recorded_cmd.extend(cmd)
               # O último argumento da lista de comando é o path do arquivo de saída temporário
    1:         out_path = Path(cmd[-1])
    1:         out_path.write_bytes(mock_mp4_content)
    1:         mock_res = MagicMock()
    1:         mock_res.returncode = 0
    1:         return mock_res
       
    2:     with patch("shutil.which", return_value="/usr/bin/ffmpeg"), \
    2:          patch("subprocess.run", side_effect=mock_run):
    1:         output = _convert_gif_to_mp4(fake_gif)
       
    1:         assert output == mock_mp4_content
               # Validação dos parâmetros de encoding H.264 exigidos
    1:         assert "-c:v" in recorded_cmd
    1:         assert "libx264" in recorded_cmd
    1:         assert "-pix_fmt" in recorded_cmd
    1:         assert "yuv420p" in recorded_cmd
    1:         assert "-an" in recorded_cmd
    1:         assert "-movflags" in recorded_cmd
    1:         assert "+faststart" in recorded_cmd
    1:         assert "-vf" in recorded_cmd
    1:         assert "scale=trunc(iw/2)*2:trunc(ih/2)*2" in recorded_cmd
       
       
    3: def test_convert_gif_to_mp4_failure_cleans_temp_file(tmp_path: Path):
    1:     fake_gif = tmp_path / "broken.gif"
    1:     fake_gif.write_bytes(b"bad_data")
       
    1:     def mock_run(cmd, *args, **kwargs):
    1:         mock_res = MagicMock()
    1:         mock_res.returncode = 1
    1:         mock_res.stderr = b"ffmpeg error parsing file"
    1:         return mock_res
       
    2:     with patch("shutil.which", return_value="/usr/bin/ffmpeg"), \
    2:          patch("subprocess.run", side_effect=mock_run):
    1:         result = _convert_gif_to_mp4(fake_gif)
    1:         assert result is None
       
       
    3: def test_convert_gif_to_mp4_exception_cleans_temp_file(tmp_path: Path):
    1:     fake_gif = tmp_path / "error.gif"
    1:     fake_gif.write_bytes(b"data")
       
    2:     with patch("shutil.which", return_value="/usr/bin/ffmpeg"), \
    2:          patch("subprocess.run", side_effect=subprocess.TimeoutExpired(cmd="ffmpeg", timeout=30)):
    1:         result = _convert_gif_to_mp4(fake_gif)
    1:         assert result is None
       
       
       # ─── 2. Testes de _prepare_media_payload ───────────────────────────────────────
       
    3: def test_prepare_media_payload_gif_success(tmp_path: Path):
    1:     gif_file = tmp_path / "sample.gif"
    1:     gif_file.write_bytes(b"GIF89a_data")
    1:     mock_mp4_bytes = b"mp4_encoded_content"
       
    2:     with patch("src.evolution_client._convert_gif_to_mp4", return_value=mock_mp4_bytes):
    1:         mediatype, mimetype, file_name, media_value, is_gif = _prepare_media_payload(gif_file)
       
    1:         assert mediatype == "video"
    1:         assert mimetype == "video/mp4"
    1:         assert file_name == "sample.mp4"
    1:         assert media_value == base64.b64encode(mock_mp4_bytes).decode("utf-8")
    1:         assert is_gif is True
       
       
    3: def test_prepare_media_payload_gif_fallback(tmp_path: Path):
    1:     gif_file = tmp_path / "fallback.gif"
