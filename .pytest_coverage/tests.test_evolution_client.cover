       # ─── 3. Testes de _build_media_payloads ────────────────────────────────────────
       
    1: def test_build_media_payloads_is_gif():
    1:     to = "5511999999999@s.whatsapp.net"
    1:     mediatype = "video"
    1:     mimetype = "video/mp4"
    1:     caption = "Legenda do GIF"
    1:     media_value = "base64_data"
    1:     file_name = "sample.mp4"
       
    2:     payloads = _build_media_payloads(
    1:         to=to,
    1:         mediatype=mediatype,
    1:         mimetype=mimetype,
    1:         caption=caption,
    1:         media_value=media_value,
    1:         file_name=file_name,
    1:         is_gif=True,
           )
       
    1:     assert len(payloads) == 4
       
           # 1. Payload v2 padrão com flag na raiz
    2:     assert payloads[0] == {
    1:         "number": to,
    1:         "mediatype": "video",
    1:         "mimetype": "video/mp4",
    1:         "caption": caption,
    1:         "media": media_value,
    1:         "fileName": file_name,
    1:         "gifPlayback": True,
           }
       
           # 2. Payload v2 com options
    2:     assert payloads[1] == {
    1:         "number": to,
    1:         "mediatype": "video",
    1:         "mimetype": "video/mp4",
    1:         "caption": caption,
    1:         "media": media_value,
    1:         "fileName": file_name,
    1:         "gifPlayback": True,
    1:         "options": {"gifPlayback": True},
           }
       
           # 3. Payload v1 legado com gifPlayback
    2:     assert payloads[2] == {
    1:         "number": to,
    2:         "mediaMessage": {
    1:             "mediatype": "video",
    1:             "mimetype": "video/mp4",
    1:             "caption": caption,
    1:             "media": media_value,
    1:             "fileName": file_name,
    1:             "gifPlayback": True,
               },
           }
       
           # 4. Fallback padrão de vídeo sem flags de GIF
    2:     assert payloads[3] == {
    1:         "number": to,
    1:         "mediatype": "video",
    1:         "mimetype": "video/mp4",
    1:         "caption": caption,
    1:         "media": media_value,
    1:         "fileName": file_name,
           }
       
       
    1: def test_build_media_payloads_not_gif():
    1:     to = "5511999999999@s.whatsapp.net"
    1:     mediatype = "image"
    1:     mimetype = "image/png"
    1:     caption = "Foto"
    1:     media_value = "base64_image_data"
    1:     file_name = "photo.png"
       
    2:     payloads = _build_media_payloads(
    1:         to=to,
    1:         mediatype=mediatype,
    1:         mimetype=mimetype,
    1:         caption=caption,
    1:         media_value=media_value,
    1:         file_name=file_name,
    1:         is_gif=False,
           )
       
    1:     assert len(payloads) == 2
    2:     assert payloads[0] == {
    1:         "number": to,
    1:         "mediatype": "image",
    1:         "mimetype": "image/png",
    1:         "caption": caption,
    1:         "media": media_value,
    1:         "fileName": file_name,
           }
    2:     assert payloads[1] == {
    1:         "number": to,
    2:         "mediaMessage": {
    1:             "mediatype": "image",
    1:             "caption": caption,
    1:             "media": media_value,
    1:             "fileName": file_name,
               },
           }
       
       
       # ─── 4. Testes de send_media (Async) e send_media_sync (Sync) ──────────────────
       
    2: @pytest.mark.asyncio
    4: async def test_send_media_async_gif(tmp_path: Path):
    1:     gif_file = tmp_path / "funny.gif"
    1:     gif_file.write_bytes(b"GIF89a_data")
    1:     mock_mp4_bytes = b"mp4_bytes"
       
    1:     mock_resp = MagicMock(spec=httpx.Response)
    1:     mock_resp.is_error = False
    1:     mock_resp.status_code = 200
    1:     mock_resp.text = '{"status": "SUCCESS"}'
       
    2:     with patch.dict(os.environ, {"EVOLUTION_API_URL": "http://test:8080", "EVOLUTION_API_KEY": "secret_key", "EVOLUTION_INSTANCE": "test_inst"}), \
    2:          patch("src.evolution_client._convert_gif_to_mp4", return_value=mock_mp4_bytes), \
    2:          patch("httpx.AsyncClient.post", new_callable=AsyncMock) as mock_post:
       
    1:         mock_post.return_value = mock_resp
       
    2:         await send_media(
    1:             to="5511999999999@s.whatsapp.net",
    1:             media_path_or_url=gif_file,
    1:             caption="Confira este GIF",
               )
       
    1:         assert mock_post.called
    1:         call_url = mock_post.call_args[0][0]
    1:         call_json = mock_post.call_args[1]["json"]
    1:         call_headers = mock_post.call_args[1]["headers"]
       
    1:         assert call_url == "http://test:8080/message/sendMedia/test_inst"
    1:         assert call_headers["apikey"] == "secret_key"
    1:         assert call_json["gifPlayback"] is True
    1:         assert call_json["mediatype"] == "video"
    1:         assert call_json["mimetype"] == "video/mp4"
    1:         assert call_json["fileName"] == "funny.mp4"
    1:         assert call_json["caption"] == "Confira este GIF"
       
       
