    2:     with patch("src.evolution_client._convert_gif_to_mp4", return_value=None):
    1:         mediatype, mimetype, file_name, media_value, is_gif = _prepare_media_payload(gif_file)
       
    1:         assert mediatype == "image"
    1:         assert mimetype == "image/gif"
