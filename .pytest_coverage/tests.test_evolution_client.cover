       # ─── 5. Testes de Segurança: Não exposição de API Key ──────────────────────────
       
    1: def test_mask_sensitive():
    1:     secret = "SUPER_SECRET_EVOLUTION_KEY_123"
    1:     text = f"Erro na requisição com key {secret} e resposta do servidor"
    1:     masked = _mask_sensitive(text, secret)
       
    1:     assert secret not in masked
    1:     assert "***REDACTED***" in masked
       
       
    3: def test_send_media_sync_error_does_not_leak_api_key(tmp_path: Path):
    1:     gif_file = tmp_path / "leak_test.gif"
    1:     gif_file.write_bytes(b"GIF89a_data")
    1:     secret_key = "MY_SECRET_KEY_98765"
       
    1:     mock_req = MagicMock()
    1:     mock_resp = MagicMock(spec=httpx.Response)
    1:     mock_resp.is_error = True
    1:     mock_resp.status_code = 401
    1:     mock_resp.text = f"Unauthorized access with token {secret_key}"
    1:     mock_resp.request = mock_req
       
    2:     with patch.dict(os.environ, {"EVOLUTION_API_URL": "http://test:8080", "EVOLUTION_API_KEY": secret_key, "EVOLUTION_INSTANCE": "test_inst"}), \
    2:          patch("src.evolution_client._convert_gif_to_mp4", return_value=b"mp4_data"), \
    2:          patch("httpx.Client.post", return_value=mock_resp):
       
    2:         with pytest.raises(httpx.HTTPStatusError) as exc_info:
    1:             send_media_sync(to="5511999999999@s.whatsapp.net", media_path_or_url=gif_file)
       
    1:         assert secret_key not in str(exc_info.value)
    1:         assert "***REDACTED***" in str(exc_info.value)
