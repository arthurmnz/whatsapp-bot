    2: class _PathGlobber(_GlobberBase):
    1:     """Provides shell-style pattern matching and globbing for pathlib paths.
           """
       
    2:     @staticmethod
    2:     def lexists(path):
               return path.info.exists(follow_symlinks=False)
       
    2:     @staticmethod
    2:     def scandir(path):
               return ((child.info, child.name, child) for child in path.iterdir())
       
    2:     @staticmethod
    2:     def concat_path(path, text):
               return path.with_segments(str(path) + text)
