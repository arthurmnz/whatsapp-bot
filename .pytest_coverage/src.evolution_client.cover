    1: async def send_text(to: str, text: str) -> None:
           """Envia uma mensagem de texto via Evolution API para o JID informado.
           Trata erros 400 executando diagnóstico e fallbacks (9º dígito BR e formato v1/v2).
       
           Args:
               to: JID do destinatário, ex: '5511999999999@s.whatsapp.net'
               text: Texto a ser enviado.
       
           Raises:
               httpx.HTTPStatusError: Se a API retornar erro HTTP mesmo após as tentativas de fallback.
           """
           base_url, api_key, instance = _get_evolution_config()
           encoded_instance = quote(instance, safe="")
           url = f"{base_url}/message/sendText/{encoded_instance}"
           headers = {"apikey": api_key, "Content-Type": "application/json"}
       
           candidates = [to] + _get_alternative_recipients(to)
           last_response: httpx.Response | None = None
       
           async with httpx.AsyncClient(timeout=15.0) as client:
               for candidate in candidates:
                   payloads = _build_payloads(candidate, text)
                   for payload in payloads:
                       try:
                           response = await client.post(url, json=payload, headers=headers)
                           last_response = response
       
                           if not response.is_error:
                               resp_summary = _mask_sensitive(response.text[:200], api_key)
                               if candidate != to:
                                   logger.info(
                                       "Mensagem enviada com sucesso utilizando fallback para '%s' (original: '%s') - Status %d: %s",
                                       candidate,
                                       to,
                                       response.status_code,
                                       resp_summary,
                                   )
                               else:
                                   logger.info(
                                       "Mensagem enviada com sucesso para '%s' - Status %d: %s",
                                       candidate,
                                       response.status_code,
                                       resp_summary,
                                   )
                               return
       
                           # Se for 400 Bad Request, loga o diagnóstico com o corpo exato da resposta
                           resp_body = _mask_sensitive(response.text, api_key)
                           logger.warning(
                               "Evolution API 400 Bad Request ao enviar para '%s' (payload=%s): %s",
                               candidate,
                               list(payload.keys()),
                               resp_body,
                           )
       
                           # Se a resposta indicar erro de schema v2, tenta o formato v1 no próximo loop
                           if "textMessage" in resp_body:
                               continue
       
                       except httpx.RequestError as req_err:
                           err_msg = _mask_sensitive(str(req_err), api_key)
                           logger.error("Erro de conexão com Evolution API em '%s': %s", url, err_msg)
                           raise
       
           if last_response is not None and last_response.is_error:
               clean_resp = _mask_sensitive(last_response.text, api_key)
               error_msg = f"Evolution API {last_response.status_code} Error: {clean_resp}"
               logger.error("Falha definitiva no envio para '%s': %s", to, error_msg)
               raise httpx.HTTPStatusError(
                   message=error_msg,
                   request=last_response.request,
                   response=last_response,
               )
       
       
    1: def send_text_sync(to: str, text: str) -> None:
           """Versão síncrona com os mesmos diagnósticos e fallbacks para compatibilidade retroativa."""
           base_url, api_key, instance = _get_evolution_config()
           encoded_instance = quote(instance, safe="")
           url = f"{base_url}/message/sendText/{encoded_instance}"
           headers = {"apikey": api_key, "Content-Type": "application/json"}
       
           candidates = [to] + _get_alternative_recipients(to)
           last_response: httpx.Response | None = None
       
           with httpx.Client(timeout=15.0) as client:
               for candidate in candidates:
                   payloads = _build_payloads(candidate, text)
                   for payload in payloads:
                       try:
                           response = client.post(url, json=payload, headers=headers)
                           last_response = response
       
                           if not response.is_error:
                               resp_summary = _mask_sensitive(response.text[:200], api_key)
                               if candidate != to:
                                   logger.info(
                                       "Mensagem enviada com sucesso utilizando fallback para '%s' (original: '%s') - Status %d: %s",
                                       candidate,
                                       to,
                                       response.status_code,
                                       resp_summary,
                                   )
                               else:
                                   logger.info(
                                       "Mensagem enviada com sucesso para '%s' - Status %d: %s",
                                       candidate,
                                       response.status_code,
                                       resp_summary,
                                   )
                               return
       
                           resp_body = _mask_sensitive(response.text, api_key)
                           logger.warning(
                               "Evolution API 400 Bad Request ao enviar para '%s' (payload=%s): %s",
                               candidate,
                               list(payload.keys()),
                               resp_body,
                           )
       
                           if "textMessage" in resp_body:
                               continue
       
                       except httpx.RequestError as req_err:
                           err_msg = _mask_sensitive(str(req_err), api_key)
                           logger.error("Erro de conexão com Evolution API em '%s': %s", url, err_msg)
                           raise
       
           if last_response is not None and last_response.is_error:
               clean_resp = _mask_sensitive(last_response.text, api_key)
               error_msg = f"Evolution API {last_response.status_code} Error: {clean_resp}"
               logger.error("Falha definitiva no envio para '%s': %s", to, error_msg)
               raise httpx.HTTPStatusError(
                   message=error_msg,
                   request=last_response.request,
                   response=last_response,
               )
       
       
