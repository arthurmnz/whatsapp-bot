       # Expressões para alternância de 9º dígito em números brasileiros:
       # Ex: 5574999298992@s.whatsapp.net -> 557499298992@s.whatsapp.net
    1: RE_BR_9_DIGIT = re.compile(r"^\+?55([1-9]{2})9(\d{8})(@s\.whatsapp\.net)?$")
       # Ex: 557499298992@s.whatsapp.net -> 5574999298992@s.whatsapp.net
    1: RE_BR_8_DIGIT = re.compile(r"^\+?55([1-9]{2})([6-9]\d{7})(@s\.whatsapp\.net)?$")
       
       
    1: def _get_evolution_config() -> tuple[str, str, str]:
    3:     base_url = os.environ.get("EVOLUTION_API_URL", "http://localhost:8080").rstrip("/")
    3:     api_key = os.environ.get("EVOLUTION_API_KEY", "")
    3:     instance = os.environ.get("EVOLUTION_INSTANCE", "")
    3:     return base_url, api_key, instance
       
       
    1: def _get_alternative_recipients(recipient: str) -> list[str]:
           """Gera formatos alternativos de número (com/sem 9º dígito brasileiro)."""
    3:     alternatives: list[str] = []
       
    3:     m9 = RE_BR_9_DIGIT.match(recipient)
    3:     if m9:
    3:         ddd, rest = m9.group(1), m9.group(2)
    3:         alternatives.append(f"55{ddd}{rest}@s.whatsapp.net")
       
    3:     m8 = RE_BR_8_DIGIT.match(recipient)
    3:     if m8:
               ddd, rest = m8.group(1), m8.group(2)
               alternatives.append(f"55{ddd}9{rest}@s.whatsapp.net")
       
    3:     return alternatives
       
       
    1: def _build_payloads(to: str, text: str) -> list[dict]:
           """Retorna payloads suportados: padrão v2 e compatibilidade v1."""
           return [
               # Formato padrão v2
               {"number": to, "text": text},
               # Formato de compatibilidade v1
               {
                   "number": to,
                   "textMessage": {"text": text},
                   "options": {"delay": 1200, "presence": "composing"},
               },
           ]
       
       
