   12:     if secret and secret in text:
   10:         return text.replace(secret, "***REDACTED***")
    2:     return text
       
       
    1: def _convert_gif_to_mp4(gif_path: Path) -> bytes | None:
           """Converte um arquivo GIF animado para MP4 (H.264 yuv420p) compatível com WhatsApp.
       
           O WhatsApp/Baileys descarta silenciosamente arquivos .gif binários enviados como imagem,
           exigindo transcodificação para vídeo MP4 com dimensões pares e pixel format yuv420p.
       
           Retorna os bytes do MP4 gerado ou None caso o ffmpeg não esteja disponível ou falhe.
           """
    4:     ffmpeg_bin = shutil.which("ffmpeg")
    4:     if not ffmpeg_bin:
    1:         logger.debug("ffmpeg não encontrado no PATH; mantendo arquivo original.")
    1:         return None
       
    3:     resolved_ffmpeg = str(Path(ffmpeg_bin).resolve())
    3:     resolved_gif = str(Path(gif_path).resolve())
    3:     tmp_mp4_path: Path | None = None
       
    3:     try:
    6:         with tempfile.NamedTemporaryFile(suffix=".mp4", delete=False) as tmp_file:
    3:             tmp_mp4_path = Path(tmp_file.name)
       
    3:         cmd = [
    3:             resolved_ffmpeg,
    3:             "-y",
    3:             "-i",
    3:             resolved_gif,
    3:             "-c:v",
    3:             "libx264",
    3:             "-pix_fmt",
    3:             "yuv420p",
    3:             "-an",
    3:             "-movflags",
    3:             "+faststart",
    3:             "-vf",
    3:             "scale=trunc(iw/2)*2:trunc(ih/2)*2",
    3:             str(tmp_mp4_path),
               ]
       
    6:         result = subprocess.run(
    3:             cmd,
    3:             stdout=subprocess.PIPE,
    3:             stderr=subprocess.PIPE,
    3:             timeout=30,
               )
    2:         if result.returncode == 0 and tmp_mp4_path.is_file() and tmp_mp4_path.stat().st_size > 0:
    1:             mp4_bytes = tmp_mp4_path.read_bytes()
    1:             logger.info("GIF '%s' convertido com sucesso para MP4 compatível com WhatsApp.", gif_path.name)
    1:             return mp4_bytes
               else:
    2:             logger.warning(
    1:                 "ffmpeg não converteu GIF '%s' (código %d): %s",
    1:                 gif_path.name,
    1:                 result.returncode,
    1:                 result.stderr.decode(errors="ignore")[:200],
                   )
    1:             return None
    1:     except Exception as exc:
    1:         logger.warning("Exceção ao converter GIF '%s' para MP4 via ffmpeg: %s", gif_path.name, exc)
    1:         return None
           finally:
    3:         if tmp_mp4_path is not None:
    3:             tmp_mp4_path.unlink(missing_ok=True)
       
       
