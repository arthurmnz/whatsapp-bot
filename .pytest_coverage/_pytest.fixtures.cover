               lines = self.errorstring.split("\n")
               if lines:
                   tw.line(
                       f"{ExceptionInfoFormatter.fail_marker}       {lines[0].strip()}",
                       red=True,
                   )
                   for line in lines[1:]:
                       tw.line(
                           f"{ExceptionInfoFormatter.flow_marker}       {line.strip()}",
                           red=True,
                       )
               tw.line()
               tw.line(f"{os.fspath(self.filename)}:{self.firstlineno + 1}")
       
       
