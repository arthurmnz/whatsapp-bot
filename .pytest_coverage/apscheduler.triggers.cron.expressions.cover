    1: """This module contains the expressions applicable for CronTrigger's fields."""
       
    1: __all__ = (
           "AllExpression",
           "LastDayOfMonthExpression",
           "RangeExpression",
           "WeekdayPositionExpression",
           "WeekdayRangeExpression",
       )
       
    1: import re
    1: from calendar import monthrange
       
    1: from apscheduler.util import asint
       
    1: WEEKDAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
    1: MONTHS = [
           "jan",
           "feb",
           "mar",
           "apr",
           "may",
           "jun",
           "jul",
           "aug",
           "sep",
           "oct",
