    1: def getreportopt(config: Config) -> str:
    1:     reportchars: str = config.option.reportchars
       
    1:     old_aliases = {"F", "S"}
    1:     reportopts = ""
    3:     for char in reportchars:
    2:         if char in old_aliases:
                   char = char.lower()
    2:         if char == "a":
                   reportopts = "sxXEf"
    2:         elif char == "A":
                   reportopts = "PpsxXEf"
    2:         elif char == "N":
                   reportopts = ""
    2:         elif char not in reportopts:
    2:             reportopts += char
       
    1:     if not config.option.disable_warnings and "w" not in reportopts:
    1:         reportopts = "w" + reportopts
           elif config.option.disable_warnings and "w" in reportopts:
               reportopts = reportopts.replace("w", "")
       
    1:     return reportopts
       
       
    2: @hookimpl(trylast=True)  # after _pytest.runner
    2: def pytest_report_teststatus(report: BaseReport) -> tuple[str, str, str]:
   39:     letter = "F"
   39:     if report.passed:
   39:         letter = "."
           elif report.skipped:
               letter = "s"
       
   39:     outcome: str = report.outcome
   39:     if report.when in ("collect", "setup", "teardown") and outcome == "failed":
               outcome = "error"
               letter = "E"
       
   39:     return outcome, letter, outcome.upper()
       
       
