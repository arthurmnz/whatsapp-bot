    1:     def __init__(self, *args):
   32:         for attr, val in zip(self.__slots__, args, strict=True):
   28:             setattr(self, attr, val)
       
    2:     @classmethod
    2:     def from_file(cls, stream):
               # The header starts with a 4-byte "magic" value
