    3:     components = key.split("/")
    3:     package_name = ".".join(["tzdata.zoneinfo"] + components[:-1])
    3:     resource_name = components[-1]
       
    3:     try:
    3:         path = resources.files(package_name).joinpath(resource_name)
               # gh-85702: Prevent PermissionError on Windows
