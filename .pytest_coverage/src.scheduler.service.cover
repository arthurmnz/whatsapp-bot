    5:         tz = ZoneInfo(timezone)
           except Exception:
               tz = ZoneInfo("America/Sao_Paulo")
       
    5:     now = datetime.datetime.now(tz)
    5:     data_str = now.strftime("%d/%m/%Y")
    5:     hora_str = now.strftime("%H:%M")
    5:     dia_semana_str = DIAS_SEMANA_PT[now.weekday()]
       
    5:     return (
    5:         template
    5:         .replace("{data}", data_str)
    5:         .replace("{hora}", hora_str)
    5:         .replace("{dia_semana}", dia_semana_str)
           )
       
       
