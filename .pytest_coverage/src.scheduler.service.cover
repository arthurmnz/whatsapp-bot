    2: class CronScheduler:
    1:     """Gerenciador do ciclo de vida e agendamentos do AsyncIOScheduler."""
       
    1:     def __init__(self, config_path: str | None = None) -> None:
    1:         self.config_path = config_path
    1:         self._config_dir = Path(config_path).parent if config_path else Path("config")
    1:         self._scheduler: AsyncIOScheduler | None = None
    1:         self._config: SchedulerConfig | None = None
       
    2:     @property
    2:     def is_running(self) -> bool:
    2:         return self._scheduler is not None and self._scheduler.running
       
    1:     def register_jobs(self, config: SchedulerConfig) -> None:
               """Limpa jobs anteriores e agenda apenas os jobs habilitados."""
    2:         if self._scheduler is None:
                   return
       
    2:         self._scheduler.remove_all_jobs()
    2:         registered_count = 0
       
    6:         for job in config.jobs:
    4:             if not job.enabled:
    1:                 logger.info("Job '%s' ignorado no agendador (enabled=false).", job.id)
    1:                 continue
       
    3:             trigger = CronTrigger.from_crontab(job.cron, timezone=ZoneInfo(config.timezone))
    6:             self._scheduler.add_job(
    3:                 dispatch_job,
    3:                 trigger=trigger,
    3:                 args=[job, config.timezone, self._config_dir],
    3:                 id=job.id,
    3:                 name=job.name,
    3:                 replace_existing=True,
                   )
    3:             registered_count += 1
    6:             logger.info(
    3:                 "Job '%s' ('%s') registrado com cron '%s' [%s].",
    3:                 job.id,
    3:                 job.name,
    3:                 job.cron,
    3:                 config.timezone,
                   )
       
    2:         logger.info("Total de %d job(s) ativo(s) registrado(s) no scheduler.", registered_count)
       
    1:     def start(self) -> None:
               """Carrega a configuração e inicia o loop do scheduler."""
    1:         self._config = load_scheduler_config(self.config_path)
       
    1:         if self._scheduler is None:
    1:             self._scheduler = AsyncIOScheduler(timezone=ZoneInfo(self._config.timezone))
       
    1:         self.register_jobs(self._config)
       
    1:         if not self._scheduler.running:
    1:             self._scheduler.start()
    1:             logger.info("CronScheduler iniciado com sucesso.")
       
    1:     def shutdown(self) -> None:
               """Finaliza o scheduler graciosamente."""
    1:         if self._scheduler is not None and self._scheduler.running:
    1:             self._scheduler.shutdown(wait=False)
    1:             logger.info("CronScheduler desligado com sucesso.")
       
    1:     def reload(self, config_path: str | None = None) -> None:
               """Recarrega a configuração do disco e reconfigura os jobs."""
               if config_path:
                   self.config_path = config_path
                   self._config_dir = Path(config_path).parent
               logger.info("Recarregando configuração do CronScheduler...")
               self._config = load_scheduler_config(self.config_path)
               self.register_jobs(self._config)
