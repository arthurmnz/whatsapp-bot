       # ─── 1. Testes de validação de expressão Cron ─────────────────────────────────
       
    1: def test_scheduled_job_valid_cron():
    2:     job = ScheduledJob(
    1:         id="test_job",
    1:         name="Job de Teste",
    1:         enabled=True,
    1:         cron="0 9 * * 1-5",
    1:         recipients=["5511999999999"],
    1:         message="Olá mundo!",
           )
    1:     assert job.cron == "0 9 * * 1-5"
       
       
    3: @pytest.mark.parametrize(
    1:     "invalid_cron",
    1:     [
               "invalid_cron",
               "99 * * * *",       # minuto inválido
               "* * * *",          # crontab requer 5 campos
               "* * * * * * *",    # campos em excesso
           ],
       )
    2: def test_scheduled_job_invalid_cron(invalid_cron):
    8:     with pytest.raises(ValidationError):
    8:         ScheduledJob(
    4:             id="test_job",
    4:             name="Job de Teste",
    4:             enabled=True,
    4:             cron=invalid_cron,
    4:             recipients=["5511999999999"],
    4:             message="Olá!",
               )
       
       
       # ─── 2. Testes de validação e sanitização de Destinatários ────────────────────
       
    1: def test_scheduled_job_recipients_sanitization():
    2:     job = ScheduledJob(
    1:         id="test_job",
    1:         name="Job de Teste",
    1:         cron="0 9 * * *",
    1:         recipients=[
                   "5511999999999",
                   "+5511888888888",
                   "5511777777777@s.whatsapp.net",
                   "120363000000000000@g.us",
               ],
    1:         message="Teste",
           )
    1:     assert job.recipients == [
               "5511999999999@s.whatsapp.net",
               "5511888888888@s.whatsapp.net",
               "5511777777777@s.whatsapp.net",
               "120363000000000000@g.us",
           ]
       
       
    3: @pytest.mark.parametrize(
    1:     "invalid_recipient",
    1:     [
               "destinatario_invalido",
               "contato@dominio.com",
               "123",              # menos de 8 dígitos
               "abc12345678",      # letras misturadas no número
           ],
       )
    2: def test_scheduled_job_invalid_recipients(invalid_recipient):
    8:     with pytest.raises(ValidationError):
    8:         ScheduledJob(
    4:             id="test_job",
    4:             name="Job de Teste",
    4:             cron="0 9 * * *",
    4:             recipients=[invalid_recipient],
    4:             message="Teste",
               )
       
       
